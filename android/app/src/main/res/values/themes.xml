<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Светлую/тёмную тему выбирает Android; заголовок окна свой, в разметке. -->
    <style name="App" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
